# Local auth signing secret (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: Supabase project settings (see README "Supabase status").
# The app does NOT use Supabase yet; it always uses the local JSON store at
# .data/store.json until the auth/data-layer wiring lands.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key; both are browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional secret / service-role key for admin scripts only.
# Server-side only: never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
