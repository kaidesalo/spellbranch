# Local auth signing secret. Required in production with the local backend.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Backend: "local" (default) or "supabase".
# Setting the Supabase keys below does NOT switch the app; this flag does.
# "supabase" moves auth AND data (decks, friends, favorites, comments) to the
# Supabase project, under RLS. Apply migrations 001-003 first (see README).
SPELLBRANCH_BACKEND=local

# The local JSON store is for development and demos only (one file, one
# process). A production build (next build / next start) refuses it unless
# this is exactly 1. Only for a single-process demo; never for shared deploys.
# SPELLBRANCH_ALLOW_LOCAL_IN_PRODUCTION=1

# Production refuses to run with SPELLBRANCH_BACKEND=supabase unless this is
# exactly 1 (auth rate limiting, review M1, is still open). Don't set it for
# shared/real deploys.
# SPELLBRANCH_ALLOW_HYBRID=1

# Supabase project settings (Project Settings -> API keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key; both are browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional secret / service-role key. Server-side only: never prefix with
# NEXT_PUBLIC_, never commit a real value. Reserved for future admin scripts;
# the app itself doesn't read it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of the app. REQUIRED when SPELLBRANCH_BACKEND=supabase: used for
# sign-up confirmation redirects and the /auth/confirm Origin (CSRF) check.
# Optional in local mode.
# SPELLBRANCH_SITE_URL=http://localhost:3847
