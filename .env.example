# Local auth signing secret. Required in production with the local backend.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Backend: "local" (default) or "supabase".
# Setting the Supabase keys below does NOT switch the app; this flag does.
# NOTE: "supabase" currently switches auth only. Decks/friends/favorites/comments
# still use the local JSON store until the Supabase data layer lands (see README).
SPELLBRANCH_BACKEND=local

# Supabase project settings (Project Settings -> API keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key; both are browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional secret / service-role key. Server-side only: never prefix with
# NEXT_PUBLIC_, never commit a real value. Makes the sign-up username check
# authoritative; also for future admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public site URL used for sign-up confirmation redirects.
# SPELLBRANCH_SITE_URL=http://localhost:3847
