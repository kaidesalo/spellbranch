# Local auth signing secret. Required in production with the local backend.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Backend: "local" (default) or "supabase".
# Setting the Supabase keys below does NOT switch the app; this flag does.
# NOTE: "supabase" currently switches auth only. Decks/friends/favorites/comments
# still use the local JSON store until the Supabase data layer lands (see README).
SPELLBRANCH_BACKEND=local

# Production refuses to start with SPELLBRANCH_BACKEND=supabase (auth-only hybrid)
# unless this is exactly 1. Don't set it for shared/real deploys.
# SPELLBRANCH_ALLOW_HYBRID=1

# Supabase project settings (Project Settings -> API keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key; both are browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional secret / service-role key. Server-side only: never prefix with
# NEXT_PUBLIC_, never commit a real value. Reserved for future admin scripts;
# the app itself doesn't read it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin of the app. REQUIRED when SPELLBRANCH_BACKEND=supabase: used for
# sign-up confirmation redirects and the /auth/confirm Origin (CSRF) check.
# Optional in local mode.
# SPELLBRANCH_SITE_URL=http://localhost:3847
