# Local auth signing secret. Required in production with the local backend.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# Backend: "local" (default) or "supabase".
# Setting the Supabase keys below does NOT switch the app; this flag does.
# "supabase" moves auth AND data (decks, friends, favorites, comments) to the
# Supabase project, under RLS. Apply migrations 001-005 first (see README).
SPELLBRANCH_BACKEND=local

# The local JSON store is for development and demos only (one file, one
# process). A production build (next build / next start) refuses it unless
# this is exactly 1. Only for a single-process demo; never for shared deploys.
# SPELLBRANCH_ALLOW_LOCAL_IN_PRODUCTION=1

# Production refuses to run with SPELLBRANCH_BACKEND=supabase unless this is
# exactly 1 (auth rate limiting, review M1, is still open). Don't set it for
# shared/real deploys.
# SPELLBRANCH_ALLOW_HYBRID=1

# Rate limiting (review M1). Both are REQUIRED in production (either backend).
# HMAC key for rate-limit counters: at least 32 bytes, different from
# AUTH_SECRET. Generate with: openssl rand -base64 32
# Rotating it resets every counter; don't rotate during an attack.
# Dev falls back to an insecure dev-only secret with a warning.
# SPELLBRANCH_RATE_LIMIT_SECRET=
# The ONE request header your platform sets (and overwrites) to the client
# IP. See README "Client IP header": x-real-ip on Vercel, cf-connecting-ip
# behind Cloudflare, x-real-ip behind your own nginx. Leave unset in dev.
# SPELLBRANCH_CLIENT_IP_HEADER=x-real-ip

# Supabase project settings (Project Settings -> API keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key; both are browser-safe.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase SECRET key (sb_secret_..., Project Settings -> API keys -> Secret
# keys). REQUIRED in production with SPELLBRANCH_BACKEND=supabase. Server-side
# only: never prefix with NEXT_PUBLIC_, never commit a real value. Used only by
# src/lib/supabase/service.ts for the rate-limit counters and the sign-up
# username check. Legacy service_role JWTs (eyJ...) are refused.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# Public origin of the app. REQUIRED when SPELLBRANCH_BACKEND=supabase: used for
# sign-up confirmation redirects and the /auth/confirm Origin (CSRF) check.
# Optional in local mode.
# SPELLBRANCH_SITE_URL=http://localhost:3847
