# Local auth signing secret (required in production)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: connect Supabase for hosted auth/database.
# Until these are set to real values, Spellbranch uses a local JSON store
# at .data/store.json with the same permission checks.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional service role key for admin scripts (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
